# Plantilla de .env para ejecutar Laravel dentro de Docker.
# El entrypoint la copia a .env si no existe.
APP_NAME=AppSolicitudes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- PostgreSQL (host = nombre del servicio en la red de Compose) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=appsolicitudes
DB_USERNAME=appsolicitudes
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# Vite debe escuchar fuera del contenedor para que el navegador lo alcance.
VITE_HOST=0.0.0.0
VITE_PORT=5173
