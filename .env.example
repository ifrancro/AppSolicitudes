# Variables del monorepo (las lee docker-compose.yml).
# Copiar a .env: cp .env.example .env

# --- PostgreSQL ---
DB_DATABASE=appsolicitudes
DB_USERNAME=appsolicitudes
DB_PASSWORD=secret
# Puerto en el host. 5433 evita chocar con un PostgreSQL instalado localmente.
DB_PORT_HOST=5433

# --- Puertos publicados ---
API_PORT=8000
VITE_PORT=5173
WEB_PORT=8080

# --- Versiones fijadas ---
FLUTTER_VERSION=3.41.9

# --- Permisos de archivos (Linux/macOS). En Windows deja 1000. ---
UID=1000
GID=1000
